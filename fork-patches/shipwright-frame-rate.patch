diff --git a/soh/ios/HarkinianPadFrameRate.mm b/soh/ios/HarkinianPadFrameRate.mm
new file mode 100644
index 000000000..d9b1b5d45
--- /dev/null
+++ b/soh/ios/HarkinianPadFrameRate.mm
@@ -0,0 +1,37 @@
+#import <QuartzCore/QuartzCore.h>
+#import <UIKit/UIKit.h>
+
+#include "HarkinianPadFrameRate.h"
+
+// The game presents Metal frames from its own loop, which alone doesn't tell iOS how fast it draws: a ProMotion
+// screen can stay at 60 Hz and hold every frame beyond that back. An idle display link carries the request instead.
+@interface HarkinianPadFrameRateRequest : NSObject
+- (void)displayRefreshed:(CADisplayLink*)link;
+@end
+
+@implementation HarkinianPadFrameRateRequest
+- (void)displayRefreshed:(CADisplayLink*)link {
+}
+@end
+
+static CADisplayLink* sDisplayLink;
+static int sDisplayFrameRate;
+
+void HarkinianPad_SetDisplayFrameRate(int fps) {
+    if (fps <= 0 || fps == sDisplayFrameRate) {
+        return;
+    }
+    sDisplayFrameRate = fps;
+
+    if (sDisplayLink == nil) {
+        // The display link keeps its target alive
+        sDisplayLink = [CADisplayLink displayLinkWithTarget:[[HarkinianPadFrameRateRequest alloc] init]
+                                                   selector:@selector(displayRefreshed:)];
+        [sDisplayLink addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+    }
+    if (@available(iOS 15.0, *)) {
+        sDisplayLink.preferredFrameRateRange = CAFrameRateRangeMake(fps, fps, fps);
+    } else {
+        sDisplayLink.preferredFramesPerSecond = fps;
+    }
+}
