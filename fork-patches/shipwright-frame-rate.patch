+// Frame rates above 20 fps are drawn as extra interpolated frames inside each game tick, and nothing drops those
+// frames when the device can't draw them in time: every tick stretches and the whole game runs in slow motion. The
+// governor times the ticks, steps the rate down until they fit their time again, and now and then retries the rates
+// above, waiting longer after each one that fails.
+class FrameRateGovernor {
+  public:
+    // The rate to draw at: the requested one, or the step below it that the device keeps up with
+    uint32_t Limit(uint32_t requested) const {
+        return mCap != 0 && mCap < requested ? mCap : requested;
+    }
+
+    // Called after each tick is drawn, with the game's own tick rate (20 per second in gameplay)
+    void EndTick(uint32_t requested, uint32_t refreshRate, uint32_t tickRate) {
+        const Clock::time_point now = Clock::now();
+        const Clock::time_point previous = mLastTickEnd;
+        mLastTickEnd = now;
+
+        if (requested != mRequested || refreshRate != mRefreshRate || tickRate != mTickRate) {
+            Reset(requested, refreshRate, tickRate);
+            return;
+        }
+        if (!CVarGetInteger(CVAR_SETTING("AdaptiveFrameRate"), 1) || tickRate == 0 || requested <= tickRate) {
+            if (mLevel != 0) {
+                SetLevel(0);
+            }
+            return;
+        }
+        if (previous == Clock::time_point{} || mSettleTicks > 0) {
+            mSettleTicks = std::max(mSettleTicks - 1, 0);
+            return;
+        }
+
+        // A rate that isn't a multiple of the tick rate draws more frames in some ticks than in others (1, 2, 1, 2 at
+        // 30 fps), so time whole repeats of that pattern against the game time they stand for
+        mCycleSeconds += std::chrono::duration<double>(now - previous).count();
+        if (++mCycleTicks < mCycleLength) {
+            return;
+        }
+        const double ratio = mCycleSeconds * tickRate / mCycleTicks;
+        mCycleSeconds = 0.0;
+        mCycleTicks = 0;
+        mRatios[mRatioNext] = ratio;
+        mRatioNext = (mRatioNext + 1) % kMaxCycles;
+        mRatioCount = std::min(mRatioCount + 1, kMaxCycles);
+
+        if (mProbing) {
+            // A rate the device can't hold costs a hitch, so give up on it quickly
+            if (ratio > kFarTooSlow || (mRatioCount >= mProbeCycles && Median(mProbeCycles) > kSlow)) {
+                mRetryDelay[mLevel] = std::min<Clock::duration>(mRetryDelay[mLevel] * 2, kMaxRetryDelay);
+                mRetryAt[mLevel] = now + mRetryDelay[mLevel];
+                SPDLOG_INFO("Frame rate {} fps can't keep game speed, retrying in {} s", mLevels[mLevel],
+                            std::chrono::duration_cast<std::chrono::seconds>(mRetryDelay[mLevel]).count());
+                SetLevel(mLevel + 1);
+            } else if (now - mProbeStart >= kProbeHold) {
+                mProbing = false;
+                mRetryDelay[mLevel] = kFirstRetryDelay;
+            }
+            return;
+        }
+
+        if (mRatioCount < mWindowCycles) {
+            return;
+        }
+        const double median = Median(mWindowCycles);
+        if (median > kSlow && mLevel + 1 < mLevels.size()) {
+            SPDLOG_INFO("Frame rate {} fps runs the game at {:.0f}% speed, lowering it", mLevels[mLevel],
+                        100.0 / median);
+            mRetryAt[mLevel] = now + mRetryDelay[mLevel];
+            SetLevel(mLevel + 1);
+        } else if (median <= kKeepingUp && mLevel > 0 && now >= mRetryAt[mLevel - 1]) {
+            SetLevel(mLevel - 1);
+            mProbing = true;
+            mProbeStart = now;
+        }
+    }
+
+  private:
+    using Clock = std::chrono::steady_clock;
+    static constexpr size_t kMaxCycles = 8;
+    static constexpr double kSlow = 1.05; // ticks 5% over their time
+    static constexpr double kFarTooSlow = 1.25;
+    static constexpr double kKeepingUp = 1.02;
+    static constexpr Clock::duration kFirstRetryDelay = std::chrono::seconds(5);
+    static constexpr Clock::duration kMaxRetryDelay = std::chrono::seconds(80);
+    static constexpr Clock::duration kProbeHold = std::chrono::seconds(3);
+
+    void Reset(uint32_t requested, uint32_t refreshRate, uint32_t tickRate) {
+        mRequested = requested;
+        mRefreshRate = refreshRate;
+        mTickRate = tickRate;
+        // Rates that divide the refresh rate keep every frame on screen equally long, so fall back through those
+        mLevels = { requested };
+        for (uint32_t divisor = 1; refreshRate / divisor >= 20; divisor++) {
+            if (refreshRate % divisor == 0 && refreshRate / divisor < requested) {
+                mLevels.push_back(refreshRate / divisor);
+            }
+        }
+        if (mLevels.back() > 20) {
+            mLevels.push_back(20);
+        }
+        mRetryDelay.assign(mLevels.size(), kFirstRetryDelay);
+        mRetryAt.assign(mLevels.size(), Clock::time_point{});
+        mLevel = 0;
+        SetLevel(0);
+    }
+
+    void SetLevel(size_t level) {
+        if (level != mLevel) {
+            SPDLOG_INFO("Frame rate now {} fps (asked for {})", mLevels[level], mRequested);
+        }
+        mLevel = level;
+        mCap = level == 0 ? 0 : mLevels[level];
+        // Rates below the tick rate draw one frame per tick
+        const uint32_t rate = std::max(mLevels[level], mTickRate);
+        mCycleLength = mTickRate == 0 ? 1 : mTickRate / std::gcd(rate, mTickRate);
+        // Judge at least 8 ticks, or 3 ticks while trying a higher rate
+        mWindowCycles = std::clamp<size_t>((8 + mCycleLength - 1) / mCycleLength, 3, kMaxCycles);
+        mProbeCycles = std::clamp<size_t>((3 + mCycleLength - 1) / mCycleLength, 2, kMaxCycles);
+        mCycleSeconds = 0.0;
+        mCycleTicks = 0;
+        mRatioCount = 0;
+        mRatioNext = 0;
+        mSettleTicks = 2;
+        mProbing = false;
+    }
+
+    double Median(size_t count) const {
+        double values[kMaxCycles];
+        for (size_t i = 0; i < count; i++) {
+            values[i] = mRatios[(mRatioNext + kMaxCycles - 1 - i) % kMaxCycles];
+        }
+        std::nth_element(values, values + count / 2, values + count);
+        return values[count / 2];
+    }
+
+    std::vector<uint32_t> mLevels = { 20 }; // highest (the requested rate) first
+    std::vector<Clock::duration> mRetryDelay = { kFirstRetryDelay };
+    std::vector<Clock::time_point> mRetryAt = { Clock::time_point{} };
+    uint32_t mRequested = 0;
+    uint32_t mRefreshRate = 0;
+    uint32_t mTickRate = 0;
+    uint32_t mCap = 0;
+    size_t mLevel = 0;
+    uint32_t mCycleLength = 1;
+    uint32_t mCycleTicks = 0;
+    double mCycleSeconds = 0.0;
+    size_t mWindowCycles = 8;
+    size_t mProbeCycles = 3;
+    double mRatios[kMaxCycles] = {};
+    size_t mRatioCount = 0;
+    size_t mRatioNext = 0;
+    int mSettleTicks = 0;
+    bool mProbing = false;
+    Clock::time_point mProbeStart;
+    Clock::time_point mLastTickEnd;
+};
+
+static FrameRateGovernor sFrameRateGovernor;
+
+uint32_t OTRGlobals::GetInterpolationFPS() {
+    return sFrameRateGovernor.Limit(GetRequestedInterpolationFPS());
+}
