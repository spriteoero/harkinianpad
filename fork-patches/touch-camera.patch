+void HarkinianPad_SetTouchCameraEnabled(int enabled) {
+    sTouchCameraDesired.store(enabled != 0);
+    if (enabled == 0) {
+        sTouchCameraDeltaX.store(0.0f);
+        sTouchCameraDeltaY.store(0.0f);
+    }
+}
+
+void HarkinianPad_SetTouchCameraGameplayActive(int active) {
+    sTouchCameraGameplayActive.store(active != 0);
+}
+
+int HarkinianPad_ConsumeTouchCameraDelta(float* dx, float* dy) {
+    if (dx == nullptr || dy == nullptr) {
+        return 0;
+    }
+    *dx = sTouchCameraDeltaX.exchange(0.0f);
+    *dy = sTouchCameraDeltaY.exchange(0.0f);
+    return *dx != 0.0f || *dy != 0.0f;
+}
