+// SoH can draw the game at a fixed aspect ratio (Advanced Resolution, N64 mode), centred in the
+// window with black bars, while the touch controls span the whole window. Returns the part of the
+// window the game image covers, as fractions of the window's width and height.
+static void HarkinianPad_GameImageFraction(float aspectRatio, float* widthFraction, float* heightFraction) {
+    const float overlayAspectRatio = sOverlayAspectRatio.load();
+    *widthFraction = 1.0f;
+    *heightFraction = 1.0f;
+    if (overlayAspectRatio <= 0.0f) {
+        return;
+    }
+    if (aspectRatio < overlayAspectRatio) {
+        *widthFraction = aspectRatio / overlayAspectRatio;
+    } else {
+        *heightFraction = overlayAspectRatio / aspectRatio;
+    }
+}
