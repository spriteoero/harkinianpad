+// Drags that begin on empty space on the right side steer the camera. The
+// controls sit above this view, so their touches are unaffected.
+@interface HarkinianPadCameraDragView : UIView
+
+// Identity of the touch steering the camera; only compared, never dereferenced.
+@property(nonatomic) uintptr_t cameraTouchId;
+@property(nonatomic) CGPoint lastPoint;
+
+- (void)cancelInput;
+
+@end
+
+@implementation HarkinianPadCameraDragView
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    self = [super initWithFrame:frame];
+    if (self != nil) {
+        self.backgroundColor = UIColor.clearColor;
+        self.multipleTouchEnabled = YES;
+    }
+    return self;
+}
+
+- (BOOL)pointInside:(CGPoint)point withEvent:(UIEvent*)event {
+    // Outside gameplay, empty space keeps passing through to the game (first-run setup, menus).
+    return (sTouchCameraDesired.load() || sFreeCamActive.load()) && sTouchCameraGameplayActive.load() &&
+           !sLayoutEditorActive.load() && [super pointInside:point withEvent:event];
+}
+
+- (UITouch*)cameraTouchIn:(NSSet<UITouch*>*)touches {
+    for (UITouch* touch in touches) {
+        if ((uintptr_t)(__bridge void*)touch == self.cameraTouchId) {
+            return touch;
+        }
+    }
+    return nil;
+}
+
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    if (self.cameraTouchId != 0) {
+        return;
+    }
+    UITouch* touch = touches.anyObject;
+    self.cameraTouchId = (uintptr_t)(__bridge void*)touch;
+    self.lastPoint = [touch locationInView:self];
+}
+
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    UITouch* touch = [self cameraTouchIn:touches];
+    if (touch == nil || !(sTouchCameraDesired.load() || sFreeCamActive.load())) {
+        return;
+    }
+    const CGPoint point = [touch locationInView:self];
+    HarkinianPad_AccumulateTouchCamera(sTouchCameraDeltaX, point.x - self.lastPoint.x);
+    HarkinianPad_AccumulateTouchCamera(sTouchCameraDeltaY, point.y - self.lastPoint.y);
+    self.lastPoint = point;
+}
+
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    if ([self cameraTouchIn:touches] != nil) {
+        self.cameraTouchId = 0;
+    }
+}
+
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    [self touchesEnded:touches withEvent:event];
+}
+
+- (void)cancelInput {
+    self.cameraTouchId = 0;
+    sTouchCameraDeltaX.store(0.0f);
+    sTouchCameraDeltaY.store(0.0f);
+}
+
+@end
