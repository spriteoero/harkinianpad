new file mode 100644
index 0000000..288d1a4
--- /dev/null
+++ b/soh/soh/Enhancements/controls/TouchFreeCam.c
@@ -0,0 +1,133 @@
+#ifdef __IOS__
+
+#include "TouchFreeCam.h"
+
+#include "global.h"
+#include "soh/Enhancements/controls/Mouse.h"
+#include "ios/HarkinianPadTouchControls.h"
+
+#define FREE_CAM_PITCH_LIMIT 0x3800
+#define FREE_CAM_SPEED 10.0f
+#define FREE_CAM_FAST_SPEED 30.0f
+// Touch deltas are UIKit points, matching the orbiting touch camera's scale.
+#define FREE_CAM_TOUCH_LOOK_SCALE 64.0f
+#define FREE_CAM_STICK_LOOK_SCALE 12.0f
+
+static s32 sFreeCamActive = false;
+static PlayState* sFreeCamPlay = NULL;
+static Vec3f sFreeCamEye;
+static s16 sFreeCamYaw;
+static s16 sFreeCamPitch;
+
+static void TouchFreeCam_SetActive(s32 active) {
+    sFreeCamActive = active;
+    HarkinianPad_SetFreeCamActive(active);
+}
+
+s32 TouchFreeCam_IsActive(void) {
+    return sFreeCamActive;
+}
+
+void TouchFreeCam_Reset(void) {
+    HarkinianPad_ConsumeFreeCamToggle();
+    sFreeCamPlay = NULL;
+    if (sFreeCamActive) {
+        TouchFreeCam_SetActive(false);
+    }
+}
+
+static s32 TouchFreeCam_CanRun(PlayState* play) {
+    return gSaveContext.gameMode == GAMEMODE_NORMAL && play->csCtx.state == CS_STATE_IDLE && !Player_InCsMode(play);
+}
+
+static void TouchFreeCam_Start(PlayState* play) {
+    VecSph look;
+
+    // Begin from whatever is on screen.
+    OLib_Vec3fDiffToVecSphGeo(&look, &play->view.eye, &play->view.lookAt);
+    sFreeCamPlay = play;
+    sFreeCamEye = play->view.eye;
+    sFreeCamYaw = look.yaw;
+    sFreeCamPitch = CLAMP(look.pitch, -FREE_CAM_PITCH_LIMIT, FREE_CAM_PITCH_LIMIT);
+    TouchFreeCam_SetActive(true);
+}
+
+s32 TouchFreeCam_Update(PlayState* play, s16 cameraIndex) {
+    Input* input;
+    f32 touchX;
+    f32 touchY;
+    f32 lookScale;
+    f32 touchYSign;
+    f32 stickXSign;
+    f32 stickYSign;
+    f32 pitch;
+    f32 speed;
+    f32 forward;
+    f32 strafe;
+    f32 rise;
+    f32 sinYaw;
+    f32 cosYaw;
+    f32 sinPitch;
+    f32 cosPitch;
+    Vec3f at;
+    Vec3f up = { 0.0f, 1.0f, 0.0f };
+
+    if (cameraIndex != play->activeCamera) {
+        return false;
+    }
+
+    if (HarkinianPad_ConsumeFreeCamToggle()) {
+        if (sFreeCamActive) {
+            TouchFreeCam_SetActive(false);
+        } else if (TouchFreeCam_CanRun(play)) {
+            TouchFreeCam_Start(play);
+        }
+    }
+    if (!sFreeCamActive) {
+        return false;
+    }
+    if (play != sFreeCamPlay || !TouchFreeCam_CanRun(play)) {
+        TouchFreeCam_SetActive(false);
+        return false;
+    }
+
+    input = &play->state.input[0];
+
+    // Drag directions match the orbiting touch camera; a physical right stick follows Free Look's settings.
+    Mouse_GetTouchCameraDelta(&touchX, &touchY);
+    lookScale = FREE_CAM_TOUCH_LOOK_SCALE * CVarGetFloat(CVAR_SETTING("HarkinianPad.TouchCameraSensitivity"), 1.0f);
+    touchYSign = CVarGetInteger(CVAR_SETTING("HarkinianPad.TouchCameraInvertY"), 0) ? -1.0f : 1.0f;
+    stickXSign = CVarGetInteger(CVAR_SETTING("FreeLook.InvertXAxis"), 0) ? -1.0f : 1.0f;
+    stickYSign = CVarGetInteger(CVAR_SETTING("FreeLook.InvertYAxis"), 1) ? -1.0f : 1.0f;
+
+    // Turning right lowers the yaw; a positive pitch looks up.
+    // Through s32 so a fast swipe wraps instead of overflowing the float-to-s16 conversion.
+    sFreeCamYaw -= (s16)(s32)(touchX * lookScale + input->cur.right_stick_x * FREE_CAM_STICK_LOOK_SCALE * stickXSign);
+    pitch = sFreeCamPitch - touchY * lookScale * touchYSign +
+            input->cur.right_stick_y * FREE_CAM_STICK_LOOK_SCALE * stickYSign;
+    sFreeCamPitch = (s16)CLAMP(pitch, -FREE_CAM_PITCH_LIMIT, FREE_CAM_PITCH_LIMIT);
+
+    speed = CHECK_BTN_ALL(input->cur.button, BTN_A) ? FREE_CAM_FAST_SPEED : FREE_CAM_SPEED;
+    forward = CLAMP(input->rel.stick_y / 60.0f, -1.0f, 1.0f) * speed;
+    strafe = CLAMP(input->rel.stick_x / 60.0f, -1.0f, 1.0f) * speed;
+    rise = (CHECK_BTN_ALL(input->cur.button, BTN_R) ? speed : 0.0f) -
+           (CHECK_BTN_ALL(input->cur.button, BTN_Z) ? speed : 0.0f);
+
+    sinYaw = Math_SinS(sFreeCamYaw);
+    cosYaw = Math_CosS(sFreeCamYaw);
+    sinPitch = Math_SinS(sFreeCamPitch);
+    cosPitch = Math_CosS(sFreeCamPitch);
+
+    // Forward follows the view; strafing stays level along screen-right, (-cos yaw, 0, sin yaw).
+    sFreeCamEye.x += forward * cosPitch * sinYaw - strafe * cosYaw;
+    sFreeCamEye.y += forward * sinPitch + rise;
+    sFreeCamEye.z += forward * cosPitch * cosYaw + strafe * sinYaw;
+
+    at.x = sFreeCamEye.x + cosPitch * sinYaw * 100.0f;
+    at.y = sFreeCamEye.y + sinPitch * 100.0f;
+    at.z = sFreeCamEye.z + cosPitch * cosYaw * 100.0f;
+    func_800AA358(&play->view, &sFreeCamEye, &at, &up);
+    return true;
+}
+
+#endif
