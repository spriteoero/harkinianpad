diff --git a/soh/soh/SohGui/MenuLanguage.cpp b/soh/soh/SohGui/MenuLanguage.cpp
new file mode 100644
index 000000000..9789faa50
--- /dev/null
+++ b/soh/soh/SohGui/MenuLanguage.cpp
@@ -0,0 +1,132 @@
+#include "MenuLanguage.h"
+
+#include <cstring>
+#include <imgui.h>
+#include <iterator>
+#include <string_view>
+#include <unordered_map>
+#include <libultraship/bridge/consolevariablebridge.h>
+#include "soh/cvar_prefixes.h"
+
+#ifdef __APPLE__
+#include <CoreFoundation/CoreFoundation.h>
+#elif defined(_WIN32)
+#include <Windows.h>
+#else
+#include <cstdlib>
+#endif
+
+namespace SohGui {
+
+namespace {
+
+struct Translation {
+    const char* english;
+    const char* korean;
+};
+
+constexpr Translation kKorean[] = {
+#include "MenuKorean.inc"
+};
+
+const std::unordered_map<std::string_view, const char*>& KoreanStrings() {
+    static const std::unordered_map<std::string_view, const char*> strings = [] {
+        std::unordered_map<std::string_view, const char*> map;
+        map.reserve(std::size(kKorean));
+        for (const Translation& translation : kKorean) {
+            map.emplace(translation.english, translation.korean);
+        }
+        return map;
+    }();
+    return strings;
+}
+
+bool SystemPrefersKorean() {
+#ifdef __APPLE__
+    bool korean = false;
+    CFArrayRef languages = CFLocaleCopyPreferredLanguages();
+    if (languages != nullptr) {
+        if (CFArrayGetCount(languages) > 0) {
+            char code[16] = {};
+            auto first = static_cast<CFStringRef>(CFArrayGetValueAtIndex(languages, 0));
+            korean =
+                CFStringGetCString(first, code, sizeof(code), kCFStringEncodingUTF8) && strncmp(code, "ko", 2) == 0;
+        }
+        CFRelease(languages);
+    }
+    return korean;
+#elif defined(_WIN32)
+    return PRIMARYLANGID(GetUserDefaultUILanguage()) == LANG_KOREAN;
+#else
+    for (const char* name : { "LC_ALL", "LC_MESSAGES", "LANG" }) {
+        const char* value = getenv(name);
+        if (value != nullptr && value[0] != '\0') {
+            return strncmp(value, "ko", 2) == 0;
+        }
+    }
+    return false;
+#endif
+}
+
+} // namespace
+
+int32_t DefaultMenuLanguage() {
+    static const int32_t language = SystemPrefersKorean() ? MENU_LANGUAGE_KOREAN : MENU_LANGUAGE_ENGLISH;
+    return language;
+}
+
+const std::map<int32_t, const char*>& MenuLanguageNames() {
+    static const std::map<int32_t, const char*> names = {
+        { MENU_LANGUAGE_ENGLISH, "English" },
+        { MENU_LANGUAGE_KOREAN, "한국어" },
+    };
+    return names;
+}
+
+const char* MenuText(const char* english) {
+    if (english == nullptr || english[0] == '\0' ||
+        CVarGetInteger(CVAR_SETTING("MenuLanguage"), DefaultMenuLanguage()) != MENU_LANGUAGE_KOREAN) {
+        return english;
+    }
+    const std::string_view text(english);
+    const size_t idStart = text.find("##");
+    const auto& strings = KoreanStrings();
+    const auto found = strings.find(text.substr(0, idStart));
+    if (found == strings.end()) {
+        return english;
+    }
+    if (idStart == std::string_view::npos) {
+        return found->second;
+    }
+    // Keep the hidden id, in a string that lives as long as the menu can show it
+    static std::unordered_map<std::string, std::string> withIds;
+    auto [entry, added] = withIds.try_emplace(english);
+    if (added) {
+        entry->second = std::string(found->second) + std::string(text.substr(idStart));
+    }
+    return entry->second.c_str();
+}
+
+std::string MenuText(const std::string& english) {
+    return MenuText(english.c_str());
+}
+
+std::string MenuLabel(const char* english) {
+    const char* shown = MenuText(english);
+    if (shown == english) {
+        return english;
+    }
+    const std::string_view text(shown);
+    return std::string(text.substr(0, text.find("##"))) + "###" + english;
+}
+
+void AddMenuTextGlyphs(ImFontGlyphRangesBuilder& builder) {
+    for (const Translation& translation : kKorean) {
+        builder.AddText(translation.korean);
+    }
+    for (const auto& [language, name] : MenuLanguageNames()) {
+        builder.AddText(name);
+    }
+}
+
+} // namespace SohGui
