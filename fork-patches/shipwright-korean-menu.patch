new file mode 100644
index 000000000..ca5cf2a85
--- /dev/null
+++ b/soh/soh/SohGui/MenuLanguage.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+
+struct ImFontGlyphRangesBuilder;
+
+namespace SohGui {
+
+enum MenuLanguage : int32_t {
+    MENU_LANGUAGE_ENGLISH,
+    MENU_LANGUAGE_KOREAN,
+};
+
+// The language the menu starts in: the system's when the menu has it, English otherwise
+int32_t DefaultMenuLanguage();
+
+// Each menu language's name, written in that language
+const std::map<int32_t, const char*>& MenuLanguageNames();
+
+// The text to show for an English menu string: its translation in the chosen menu language, or the string itself.
+// A hidden ImGui "##id" suffix is kept.
+const char* MenuText(const char* english);
+std::string MenuText(const std::string& english);
+
+// For ImGui widgets that take their ID from their label: the translated label, keeping the English one as the ID
+std::string MenuLabel(const char* english);
+
+// Adds every character the translations use, so the menu fonts can include them
+void AddMenuTextGlyphs(ImFontGlyphRangesBuilder& builder);
+
+} // namespace SohGui
