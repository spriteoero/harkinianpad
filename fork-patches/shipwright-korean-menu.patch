diff --git a/soh/ios/HarkinianPadModImport.mm b/soh/ios/HarkinianPadModImport.mm
index cc629b7ec..7776a583a 100644
--- a/soh/ios/HarkinianPadModImport.mm
+++ b/soh/ios/HarkinianPadModImport.mm
@@ -2,16 +2,27 @@
 #import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
 #include "HarkinianPadModImport.h"
 #include "../soh/Enhancements/ModPackImport.h"
+#include "../soh/SohGui/MenuLanguage.h"
 #include <atomic>
 #include <mutex>
+#include <spdlog/fmt/fmt.h>
 #include <spdlog/spdlog.h>
 
 static std::atomic_bool busy(false), completed(false);
 static std::mutex statusMutex;
-static std::string status = "Import .o2r, .otr, or ZIP packs. Extract .7z downloads first.";
-static void SetStatus(std::string message) {
+// Kept in English and translated when shown, so it follows the menu language
+struct ImportStatus {
+    std::string message = "Import .o2r, .otr, or ZIP packs. Extract .7z downloads first.";
+    bool finished = false;
+    size_t imported = 0, failed = 0;
+};
+static ImportStatus status;
+static void SetStatus(ImportStatus next) {
     std::lock_guard<std::mutex> lock(statusMutex);
-    status = std::move(message);
+    status = std::move(next);
+}
+static void SetStatus(std::string message) {
+    SetStatus(ImportStatus{ std::move(message) });
 }
 @interface HarkinianPadModPicker : NSObject <UIDocumentPickerDelegate>
 @end
@@ -63,8 +74,7 @@ static HarkinianPadModPicker* delegate;
                 lastError = coordinationError ? "Cannot read the selected file. Download it in Files and retry." : failure;
             } else imported += count;
         }
-        SetStatus("Imported " + std::to_string(imported) + " pack(s). " +
-                  (failed ? std::to_string(failed) + " file(s) failed: " + lastError : "Enable them in Edit, then save and restart."));
+        SetStatus(ImportStatus{ lastError, true, imported, failed });
         SPDLOG_INFO("HarkinianPad mod import: imported={}, failed={}", imported, failed);
         completed = imported != 0;
         busy = false;
@@ -101,4 +111,12 @@ void HarkinianPad_ImportMods() {
 }
 bool HarkinianPad_ModImportBusy() { return busy.load(); }
 bool HarkinianPad_ModImportCompleted() { return completed.exchange(false); }
-std::string HarkinianPad_ModImportStatus() { std::lock_guard<std::mutex> lock(statusMutex); return status; }
+std::string HarkinianPad_ModImportStatus() {
+    std::lock_guard<std::mutex> lock(statusMutex);
+    if (!status.finished) return SohGui::MenuText(status.message);
+    const std::string imported = fmt::format(fmt::runtime(SohGui::MenuText("Imported {} pack(s).")), status.imported);
+    if (!status.failed) return imported + " " + SohGui::MenuText("Enable them in Edit, then save and restart.");
+    return imported + " " +
+           fmt::format(fmt::runtime(SohGui::MenuText("{} file(s) failed: {}")), status.failed,
